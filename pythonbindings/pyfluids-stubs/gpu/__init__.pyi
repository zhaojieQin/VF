            self,
            maximum_amplitude_x: float,
            maximum_amplitude_y: float,
            maximum_amplitude_z: float,
        ) -> None: ...

    def __init__(
        self,
        para: Parameter,
        cuda_memory_manager: CudaMemoryManager,
        diameter: float,
        blade_radii: npt.ArrayLike,
        turbine_positions_x: npt.ArrayLike,
