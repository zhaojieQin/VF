class ActuatorFarm(PreCollisionInteractor):
    class HubConfig:
        length: float
        radius: float
        position_offset: float
        number_of_points_per_turbine: int
        def __init__(
            self,
            length: float,
            radius: float,
            position_offset: float,
            number_of_points_per_turbine: int,
        ) -> None: ...

    class TowerConfig:
        radius: float
        offset: float
        tower_heights: npt.NDArray[np.float32]
        number_of_points_per_turbine: int
        def __init__(
            self,
            radius: float,
            offset: float,
            tower_heights: npt.ArrayLike,
            number_of_points_per_turbine: int,
        ) -> None: ...

    class VAWTConfig:
        rotor_height: float
        flag_localized_smearing_width: bool
        def __init__(self, rotor_height: float, flag_localized_smearing_width: bool) -> None: ...

    class FloatingConfig:
        maximum_amplitude_x: float
        maximum_amplitude_y: float
        maximum_amplitude_z: float
