    def get_all_blade_forces_y(self) -> npt.NDArray[np.float32]: ...
    def get_all_blade_forces_z(self) -> npt.NDArray[np.float32]: ...

    def get_all_coords_x_device(self) -> int: ...
    def get_all_coords_y_device(self) -> int: ...
    def get_all_coords_z_device(self) -> int: ...
    def get_all_velocities_x_device(self) -> int: ...
    def get_all_velocities_y_device(self) -> int: ...
    def get_all_velocities_z_device(self) -> int: ...
    def get_all_forces_x_device(self) -> int: ...
    def get_all_forces_y_device(self) -> int: ...
    def get_all_forces_z_device(self) -> int: ...

    def get_all_blade_coords_x_device(self) -> int: ...
    def get_all_blade_coords_y_device(self) -> int: ...
    def get_all_blade_coords_z_device(self) -> int: ...
    def get_all_blade_velocities_x_device(self) -> int: ...
    def get_all_blade_velocities_y_device(self) -> int: ...
    def get_all_blade_velocities_z_device(self) -> int: ...
    def get_all_blade_forces_x_device(self) -> int: ...
    def get_all_blade_forces_y_device(self) -> int: ...
    def get_all_blade_forces_z_device(self) -> int: ...

    def get_all_hub_coords_x_device(self) -> int: ...
    def get_all_hub_coords_y_device(self) -> int: ...
    def get_all_hub_coords_z_device(self) -> int: ...
    def get_all_hub_velocities_x_device(self) -> int: ...
    def get_all_hub_velocities_y_device(self) -> int: ...
    def get_all_hub_velocities_z_device(self) -> int: ...
    def get_all_hub_forces_x_device(self) -> int: ...
    def get_all_hub_forces_y_device(self) -> int: ...
    def get_all_hub_forces_z_device(self) -> int: ...

    def get_all_tower_coords_x_device(self) -> int: ...
    def get_all_tower_coords_y_device(self) -> int: ...
    def get_all_tower_coords_z_device(self) -> int: ...
    def get_all_tower_velocities_x_device(self) -> int: ...
    def get_all_tower_velocities_y_device(self) -> int: ...
    def get_all_tower_velocities_z_device(self) -> int: ...
    def get_all_tower_forces_x_device(self) -> int: ...
    def get_all_tower_forces_y_device(self) -> int: ...
    def get_all_tower_forces_z_device(self) -> int: ...

    def set_all_blade_coords(self, blade_coords_x: npt.NDArray[np.float32], blade_coords_y: npt.NDArray[np.float32], blade_coords_z: npt.NDArray[np.float32]) -> None: ...
    def set_all_blade_velocities(self, blade_velocities_x: npt.NDArray[np.float32], blade_velocities_y: npt.NDArray[np.float32], blade_velocities_z: npt.NDArray[np.float32]) -> None: ...
    def set_all_blade_forces(self, blade_forces_x: npt.NDArray[np.float32], blade_forces_y: npt.NDArray[np.float32], blade_forces_z: npt.NDArray[np.float32]) -> None: ...
